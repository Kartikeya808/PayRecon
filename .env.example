# PayRecon environment — copy to .env.local and fill in real values.
# Every variable the app reads is listed here. No real secrets in this file.

# --- Database (Postgres / Neon) ---------------------------------------------
# Connection string used by Drizzle and Better Auth.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth (Better Auth) -----------------------------------------------------
# Long random string used to sign sessions.
BETTER_AUTH_SECRET=
# Must match the URL the app is served from (e.g. http://localhost:3001 in dev,
# or https://<project>.vercel.app in production), or auth cookies/redirects break.
BETTER_AUTH_URL=http://localhost:3001

# Optional "Continue with Google". Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Model (extraction + agent + explanations) ------------------------------
# stub = deterministic placeholders, spends nothing. live = real model calls.
LLM_MODE=stub
MODEL_API_KEY=
MODEL_BASE_URL=
# Guardrail: the app refuses a Contributor-tier model (may train on data).
MODEL_TIER=standard
# Optional reasoning-effort override (e.g. low | medium | high).
MODEL_REASONING_EFFORT=
# Per-account spend cap in USD for live model calls.
MODEL_BUDGET_USD=

# --- FX rates ---------------------------------------------------------------
# static = fixed reference rates (spends nothing). live = ECB via Frankfurter.
FX_MODE=static

# --- Object storage for uploads (optional) ----------------------------------
# When unset, uploads are written to a local/ephemeral dir (see UPLOADS_DIR).
# Set all three to use S3-compatible storage (e.g. Neon Object Storage).
BLOB_ENDPOINT=
BLOB_ACCESS_KEY_ID=
BLOB_SECRET_ACCESS_KEY=

# --- Local paths (optional) -------------------------------------------------
# Override where uploads / demo data live on disk. Sensible defaults otherwise.
UPLOADS_DIR=
PMA_DATA_DIR=

# NODE_ENV and VERCEL are set automatically by the runtime — do not set them here.
